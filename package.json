{
    "name":  "library-management-system",
    "version":  "1.0.0",
    "description":  "Professional Desktop Library Management System",
    "main":  "dist/main/main.js",
    "scripts":  {
                    "dev":  "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
                    "dev:react":  "vite",
                    "dev:electron":  "wait-on tcp:5173 \u0026\u0026 node build-electron.js --dev \u0026\u0026 electron .",
                    "start":  "npm run build \u0026\u0026 electron .",
                    "build":  "npm run build:react \u0026\u0026 npm run build:electron",
                    "build:react":  "vite build",
                    "build:electron":  "node build-electron.js",
                    "pack":  "npm run build \u0026\u0026 electron-builder --dir",
                    "dist":  "npm run build \u0026\u0026 electron-builder",
                    "postinstall":  "electron-rebuild -f -w better-sqlite3"
                },
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "better-sqlite3":  "^9.4.3",
                         "date-fns":  "^3.3.1",
                         "lucide-react":  "^0.344.0",
                         "react":  "^18.2.0",
                         "react-dom":  "^18.2.0",
                         "recharts":  "^2.12.2",
                         "uuid":  "^9.0.1"
                     },
    "devDependencies":  {
                            "@electron/rebuild":  "^3.6.0",
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/better-sqlite3":  "^7.6.8",
                            "@types/node":  "^20.11.24",
                            "@types/react":  "^18.2.61",
                            "@types/react-dom":  "^18.2.19",
                            "@types/uuid":  "^9.0.8",
                            "@vitejs/plugin-react":  "^4.2.1",
                            "concurrently":  "^8.2.2",
                            "cross-env":  "^7.0.3",
                            "electron":  "^45.2.1",
                            "electron-builder":  "^24.13.3",
                            "esbuild":  "^0.20.1",
                            "typescript":  "^5.3.3",
                            "vite":  "^5.1.5",
                            "wait-on":  "^7.2.0"
                        },
    "build":  {
                  "appId":  "com.library.lms",
                  "productName":  "Library Management System",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "win":  {
                              "target":  "nsis"
                          },
                  "files":  [
                                "dist/**/*",
                                "node_modules/**/*"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
                                             "to":  "better_sqlite3.node"
                                         }
                                     ]
              }
}
